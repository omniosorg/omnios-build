illumos ptys are STREAMS devices and need special handling:

- OpenPTY() must only open the manager side. The generic code uses
  openpty(), which opens the subordinate too, and then immediately closes
  it; on illumos that last-close queues a zero-length message (EOF) for
  the manager side, which the event loop later reads as the window having
  died, and dismantles the subordinate STREAM.

- The ptem and ldterm modules must be pushed onto the subordinate side
  when it is first opened, which happens in ForkWindow().

diff -wpruN --no-dereference '--exclude=*.orig' a~/pty.c a/pty.c
--- a~/pty.c	1970-01-01 00:00:00
+++ a/pty.c	1970-01-01 00:00:00
@@ -48,6 +48,44 @@ int pty_preopen = 0;
 
 /***************************************************************/
 
+#ifdef __illumos__
+#include <stdlib.h>
+#include <string.h>
+
+/*
+ * illumos ptys are STREAMS devices; the modules which provide terminal
+ * semantics must be pushed onto the subordinate side before it can be
+ * used as a terminal, and that is done in ForkWindow() when the
+ * subordinate side is first opened. openpty() is deliberately not used
+ * here since closing the last file descriptor for the subordinate side
+ * queues a zero-length message (EOF) for the manager side and dismantles
+ * the subordinate STREAM, popping any pushed modules. The manager side
+ * must be opened without ever opening and closing the subordinate.
+ */
+int OpenPTY(char **ttyn)
+{
+	static char TtyName[32];
+	char *sname;
+	int f;
+
+	if ((f = posix_openpt(O_RDWR | O_NOCTTY)) == -1)
+		return -1;
+	if (grantpt(f) == -1 || unlockpt(f) == -1 ||
+	    (sname = ptsname(f)) == NULL) {
+		close(f);
+		return -1;
+	}
+	strlcpy(TtyName, sname, sizeof (TtyName));
+
+#if defined(LOCKPTY) && defined(TIOCEXCL) && defined(TIOCNXCL)
+	(void)ioctl(f, TIOCEXCL, NULL);
+#endif
+
+	pty_preopen = 1;
+	*ttyn = TtyName;
+	return f;
+}
+#else
 int OpenPTY(char **ttyn)
 {
 	static char TtyName[32];
@@ -66,6 +104,7 @@ int OpenPTY(char **ttyn)
 	*ttyn = TtyName;
 	return f;
 }
+#endif /* __illumos__ */
 
 int ClosePTY(int fd)
 {
diff -wpruN --no-dereference '--exclude=*.orig' a~/window.c a/window.c
--- a~/window.c	1970-01-01 00:00:00
+++ a/window.c	1970-01-01 00:00:00
@@ -41,6 +41,9 @@
 #include <fcntl.h>
 #include <sys/ioctl.h>
 #include <sys/wait.h>
+#ifdef __illumos__
+#include <sys/stropts.h>
+#endif
 
 #include "fileio.h"
 #include "help.h"
@@ -1031,6 +1034,25 @@ static int ForkWindow(Window *win, char
 			Msg(errno, "ttyn");
 			return -1;
 		}
+#ifdef __illumos__
+		/*
+		 * The first open of a pty subordinate side creates a bare
+		 * STREAM; the modules which provide terminal semantics must
+		 * be pushed before it can be used as a terminal. The push is
+		 * skipped if ldterm is already present - a real terminal
+		 * device passed to screen, or a window being resurrected.
+		 * This process may be a session leader without a controlling
+		 * terminal, so use the variant of I_PUSH which does not
+		 * allocate one.
+		 */
+		if (ioctl(slave, I_FIND, "ldterm") == 0 &&
+		    (ioctl(slave, __I_PUSH_NOCTTY, "ptem") == -1 ||
+		    ioctl(slave, __I_PUSH_NOCTTY, "ldterm") == -1)) {
+			Msg(errno, "cannot push STREAMS modules");
+			close(slave);
+			return -1;
+		}
+#endif
 	}
 #endif
 	proc = *args;
