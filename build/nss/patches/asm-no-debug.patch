diff -wpruN --no-dereference '--exclude=*.orig' a~/lib/freebl/intel-gcm-wrap.gyp a/lib/freebl/intel-gcm-wrap.gyp
--- a~/lib/freebl/intel-gcm-wrap.gyp	1970-01-01 00:00:00
+++ a/lib/freebl/intel-gcm-wrap.gyp	1970-01-01 00:00:00
@@ -16,6 +16,12 @@
     'cflags': [
       '-mssse3',
     ],
+    # The gyp ninja generator prepends $CFLAGS from the environment to any
+    # target cflags, so this -g0 lands last and wins. Without it, gas emits
+    # line-only DWARF for the .S sources which ctfconvert cannot process.
+    'cflags_c': [
+      '-g0',
+    ],
     'cflags_mozilla': [
       '-mssse3'
     ],
