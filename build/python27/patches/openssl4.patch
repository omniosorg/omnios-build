+/* Create a context which is restricted to a single protocol version */
+static SSL_CTX *
+context_new_version(int version)
+{
+    SSL_CTX *ctx = SSL_CTX_new(TLS_method());
+
+    if (ctx != NULL &&
+        (!SSL_CTX_set_min_proto_version(ctx, version) ||
+        !SSL_CTX_set_max_proto_version(ctx, version))) {
+        SSL_CTX_free(ctx);
+        ctx = NULL;
