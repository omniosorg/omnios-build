From a773ed17a06a68cb590c5b47d4c7881a22b76f27 Mon Sep 17 00:00:00 2001
From: Andy Fiddaman <illumos@fiddaman.net>
Date: Sat, 7 Nov 2026 16:52:31 +0000
Subject: i386: keep debug locations across the -msave-args prologue

With -msave-args, debuggers can lose parameters and values loaded
through them at optimised levels, showing <optimized out> or
[uninitialized]. There are two reasons for this.

The push of an argument register has no REG_EXPR, so var-tracking saw
a use with no variable and dropped the parameter from the register,
even though the prologue only reads it. Ignore such uses in
frame-related insns.

The pushes of %rbp and the argument registers also have no alias set,
so cselib invalidated memory that debug binds had already referred to,
because those binds sit ahead of the prologue. Put them in the frame
alias set.

Memory with alias set zero, such as a type-punned load, can still be
invalidated, so a few gcc.dg/guality/pr59776.c cases remain.
---
 gcc/config/i386/i386.cc | 19 +++++++++++++++++--
 gcc/var-tracking.cc     | 11 +++++++++++
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/gcc/config/i386/i386.cc b/gcc/config/i386/i386.cc
index 56bed311fe6..fffa6bede54 100644
--- a/gcc/config/i386/i386.cc
+++ b/gcc/config/i386/i386.cc
@@ -6653,6 +6653,18 @@ gen_push (rtx arg, bool ppx_p)
   return ppx_p ? gen_pushp_di (stack, arg) : gen_rtx_SET (stack, arg);
 }
 
+/* Generate a push of REG for -msave-args.  These run before the code that
+   parameters' debug locations depend on, so use the frame alias set to show
+   that they cannot clobber memory that those locations refer to.  */
+
+static rtx
+gen_save_args_push (rtx reg)
+{
+  rtx pat = gen_push (reg);
+  set_mem_alias_set (SET_DEST (pat), get_frame_alias_set ());
+  return pat;
+}
+
 rtx
 gen_pushfl (void)
 {
@@ -7641,7 +7653,8 @@ ix86_emit_save_regs (void)
       for (i = start; i < start + frame.nmsave_args; i++)
 	{
 	  regno = x86_64_int_parameter_registers[i];
-	  insn = emit_insn (gen_push (gen_rtx_REG (word_mode, regno)));
+	  insn = emit_insn (gen_save_args_push (gen_rtx_REG (word_mode,
+							     regno)));
 	  RTX_FRAME_RELATED_P (insn) = 1;
 	}
       if (frame.nmsave_args % 2 != 0)
@@ -9580,7 +9593,9 @@ ix86_expand_prologue (void)
     {
       /* Note: AT&T enter does NOT have reversed args.  Enter is probably
          slower on all targets.  Also sdb didn't like it.  */
-      insn = emit_insn (gen_push (hard_frame_pointer_rtx));
+      insn = emit_insn (TARGET_SAVE_ARGS
+			? gen_save_args_push (hard_frame_pointer_rtx)
+			: gen_push (hard_frame_pointer_rtx));
       RTX_FRAME_RELATED_P (insn) = 1;
 
       if (m->fs.sp_offset == frame.hard_frame_pointer_offset)
diff --git a/gcc/var-tracking.cc b/gcc/var-tracking.cc
index e7065e81ca5..af850d43527 100644
--- a/gcc/var-tracking.cc
+++ b/gcc/var-tracking.cc
@@ -5675,6 +5675,17 @@ static void
 add_uses (rtx loc, struct count_use_info *cui)
 {
   machine_mode mode = VOIDmode;
+
+  /* A prologue that saves an incoming argument register only reads it.
+     The register has no REG_EXPR, so treating this as a use with no
+     variable would drop the parameter from its register (-msave-args).  */
+  if (REG_P (loc)
+      && !REG_EXPR (loc)
+      && FUNCTION_ARG_REGNO_P (REGNO (loc))
+      && cui->insn
+      && RTX_FRAME_RELATED_P (cui->insn))
+    return;
+
   enum micro_operation_type type = use_type (loc, cui, &mode);
 
   if (type != MO_CLOBBER)
