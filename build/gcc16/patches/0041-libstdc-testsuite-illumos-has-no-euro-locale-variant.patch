From c4f1b6df45ed4385ea6d3fd50c19f878653c2032 Mon Sep 17 00:00:00 2001
From: Andy Fiddaman <illumos@fiddaman.net>
Date: Sat, 7 Nov 2026 11:23:40 +0000
Subject: libstdc++ testsuite: illumos has no @euro locale variants

The testsuite's ISO_8859(15, lang_TERR) macro in testsuite_hooks.h
produces "lang_TERR.ISO8859-15@euro" on every platform other than the
BSDs, because that is what the ISO8859-15 locales are called in glibc
and Oracle Solaris. Treat illumos like the BSDs.
---
 libstdc++-v3/testsuite/lib/libstdc++.exp      | 2 +-
 libstdc++-v3/testsuite/util/testsuite_hooks.h | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/libstdc++-v3/testsuite/lib/libstdc++.exp b/libstdc++-v3/testsuite/lib/libstdc++.exp
index 4ffbf106b6b..57804194801 100644
--- a/libstdc++-v3/testsuite/lib/libstdc++.exp
+++ b/libstdc++-v3/testsuite/lib/libstdc++.exp
@@ -1080,7 +1080,7 @@ proc check_v3_target_namedlocale { locale } {
 	puts $f "{"
 	puts $f "    char *result = new char\[strlen(name)+6\];"
 	puts $f "    strcpy(result, name);"
-	puts $f "#if defined __FreeBSD__ || defined __DragonFly__ || defined __NetBSD__"
+	puts $f "#if defined __FreeBSD__ || defined __DragonFly__ || defined __NetBSD__ || defined __illumos__"
 	puts $f "    /* fall-through */"
 	puts $f "#elif defined __GLIBC__"
 	puts $f "    if (strstr(result, \"ISO8859-15\")) {"
diff --git a/libstdc++-v3/testsuite/util/testsuite_hooks.h b/libstdc++-v3/testsuite/util/testsuite_hooks.h
index 49e8f0fe30b..4f4bd947f77 100644
--- a/libstdc++-v3/testsuite/util/testsuite_hooks.h
+++ b/libstdc++-v3/testsuite/util/testsuite_hooks.h
@@ -72,7 +72,8 @@
 # define unlink(x)
 #endif
 
-#if defined __FreeBSD__ || defined __DragonFly__ || defined __NetBSD__
+#if defined __FreeBSD__ || defined __DragonFly__ || defined __NetBSD__ \
+  || defined __illumos__
 # define ISO_8859(part,langTERR) #langTERR ".ISO8859-" #part
 #else
 # define ISO_8859(part,langTERR) ((part) == 15 ?\
