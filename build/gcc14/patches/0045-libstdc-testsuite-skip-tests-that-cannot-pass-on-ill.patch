@@ -22,6 +22,7 @@
 // 15.25 Permissions [fs.op.last_write_time]
 
 #include <filesystem>
+#include <cerrno>
 #include <limits>
 #include <testsuite_fs.h>
 #include <testsuite_hooks.h>
@@ -85,12 +86,25 @@ test01()
   ts[0].tv_nsec = UTIME_NOW;
   ts[1].tv_sec = std::numeric_limits<std::time_t>::max() - 1;
