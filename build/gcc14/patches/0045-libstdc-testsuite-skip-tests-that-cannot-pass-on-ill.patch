+    {
+      VERIFY( errno == EOVERFLOW );
+      puts("Filesystem rejects far-future timestamps, "
+	   "can't test for overflow on this target.");
+      return;
+    }
 #else
   puts("No utimensat or utime, giving up.");
   return;
